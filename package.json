{
  "name": "foxpilot-mcp",
  "version": "0.2.0",
  "description": "MCP server that lets Claude and other AI agents control your real browser — Firefox, Zen and other Firefox forks over WebDriver BiDi, Chromium browsers (Chrome, Helium, Brave, Edge) over CDP. No extension needed.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "browser-automation",
    "firefox",
    "zen-browser",
    "chromium",
    "helium",
    "webdriver-bidi",
    "cdp",
    "claude",
    "ai-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SDH4114/foxpilot-mcp.git"
  },
  "homepage": "https://github.com/SDH4114/foxpilot-mcp#readme",
  "type": "module",
  "bin": {
    "foxpilot-mcp": "src/server.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "smoke": "node scripts/smoke.mjs",
    "launcher": "scripts/make-launcher.sh",
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=22.12"
  },
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "puppeteer-core": "^25.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4"
  }
}
